MONGODB_URI=
# Signs staff login cookies — generate with `openssl rand -hex 32`
ADMIN_SESSION_SECRET=
# One-time key needed at /setup to create the first admin (falls back to ADMIN_PASSWORD)
SETUP_KEY=
NEXT_PUBLIC_APP_NAME=જમાવટ
# Realtime (optional — without it screens poll every 5s)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
# Guest email OTP / bill email via Gmail: your Gmail address + an App Password
# (Google Account → Security → 2-Step Verification → App passwords)
SMTP_USER=
SMTP_PASS=
# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (default 465), MAIL_FROM
# Origin printed in table QR codes, e.g. https://jamavat.vercel.app
APP_URL=
